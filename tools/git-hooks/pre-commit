#!/bin/sh
# NETUNIM_MANAGED_HOOK: asset-sync-v2

# Replaced with the verified interpreter path by tools/install-git-hooks.py.
python_executable=@PYTHON_EXECUTABLE@

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "ERROR: NETUNIM asset hook could not locate the repository root." >&2
  exit 1
}
cd "$repo_root" || exit 1

if [ ! -f "$python_executable" ]; then
  echo "ERROR: NETUNIM's configured Python interpreter is no longer available:" >&2
  echo "  $python_executable" >&2
  echo "Run 'python tools/install-git-hooks.py' to refresh the local hook." >&2
  exit 1
fi

PYTHONUTF8=1 "$python_executable" tools/sync-assets.py --staged
exit $?
